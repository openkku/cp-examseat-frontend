# URL of the Go backend (openkku/cp-examseat-backend). Read at runtime by
# src/proxy.ts, which forwards /api/* and /room/image/* to it.
BACKEND_URL=http://localhost:8080

# Optional, build time: call the backend directly from the browser instead of
# through the proxy. The backend must list this site in CORS_ALLOWED_ORIGINS.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Rate limiting happens in the backend per client IP, read from the
# X-Forwarded-For header this app forwards. Next.js passes that header on
# unchanged, so run a reverse proxy in front of this app that sets it
# (see README "Deployment").
