# Copy to .env and edit. docker compose reads it automatically.

# --- Reverse proxy ---------------------------------------------------------
# Public domain; its DNS must point at this server (ports 80 and 443 open).
DOMAIN=exam.example.com
# Runs the bundled Caddy (HTTPS on 80/443). Delete this line if the host
# already has nginx/Caddy; point it at 127.0.0.1:3000 (see README.md).
COMPOSE_PROFILES=caddy

# --- Admin -----------------------------------------------------------------
# Enables /admin. Generate with: openssl rand -hex 32
# Empty keeps the admin page and API switched off.
ADMIN_TOKEN=

# --- Images ----------------------------------------------------------------
# latest, sha-<7-char commit> (rollback), or X.Y.Z for v* release tags.
FRONTEND_TAG=latest
BACKEND_TAG=latest

# --- Host paths ------------------------------------------------------------
# exams.db and room/ (metadata.json, map/, image/) live here.
DATA_DIR=./data
# Put backups on another disk if you can.
BACKUP_HOST_DIR=./backups

# --- Optional (defaults shown) ---------------------------------------------
# FRONTEND_PORT=3000
# BACKUP_INTERVAL=24h
# BACKUP_KEEP=7
# Per client IP. Raise these if many students share one address (campus NAT).
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=40
# Serve room images from a CDN instead of the backend.
# IMAGE_BASE_URL=
